# ===========================================
# Collector.shop - Production Environment
# ===========================================
# 1. Copy this file to .env.prod
# 2. Fill in ALL values with secure production credentials
# 3. NEVER commit .env.prod to git!
# ===========================================

# ===========================================
# Domain Configuration
# ===========================================
# Option 1: With a domain (recommended for production)
# DOMAIN=collector.shop
# ACME_EMAIL=admin@collector.shop

# Option 2: Without a domain (for testing with IP only)
# Use your VPS IP address - HTTPS won't work, use HTTP only
DOMAIN=YOUR_VPS_IP_HERE
ACME_EMAIL=your-email@example.com

# Traefik Dashboard Auth (generate with: htpasswd -nb admin yourpassword)
# Example: admin:$apr1$xyz...
TRAEFIK_AUTH=admin:$$apr1$$REPLACE_WITH_HTPASSWD_OUTPUT

# ===========================================
# Database - PostgreSQL
# ===========================================
POSTGRES_USER=collector
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
POSTGRES_DB=collector_prod

# ===========================================
# Cache - Redis
# ===========================================
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=7d

# ===========================================
# Stripe (Payment) - LIVE KEYS
# ===========================================
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# ===========================================
# S3 / MinIO (Storage)
# ===========================================
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_BUCKET=collector-images
S3_REGION=us-east-1

# ===========================================
# Email (SendGrid) - Optional
# ===========================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
EMAIL_FROM=noreply@collector.shop
