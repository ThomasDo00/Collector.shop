# ===========================================
# Collector.shop - IP-Only Deployment (No Domain)
# ===========================================
# Use this when you don't have a domain yet.
# Copy to .env.prod and fill in values.
#
# IMPORTANT: Use hex passwords (no special characters)
#   Generate with: openssl rand -hex 32
# ===========================================

# Your VPS IP address
VPS_IP=YOUR_VPS_IP_HERE

# ===========================================
# Database - PostgreSQL
# ===========================================
POSTGRES_USER=collector
POSTGRES_PASSWORD=CHANGE_ME_USE_HEX
POSTGRES_DB=collector_prod

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_HEX
JWT_EXPIRES_IN=7d

# ===========================================
# S3 / MinIO (Storage)
# ===========================================
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_USE_HEX
S3_BUCKET=collector-images

# ===========================================
# Stripe (Optional - for payments)
# ===========================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
