# ===========================================
# Collector.shop - IP-Only Deployment (No Domain)
# ===========================================
# Use this when you don't have a domain yet.
# Copy to .env.prod and fill in values.
# ===========================================

# Your VPS IP address
VPS_IP=YOUR_VPS_IP_HERE

# ===========================================
# Database - PostgreSQL
# ===========================================
POSTGRES_USER=collector
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=collector_prod

# ===========================================
# Cache - Redis
# ===========================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_EXPIRES_IN=7d

# ===========================================
# S3 / MinIO (Storage)
# ===========================================
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=collector-images

# ===========================================
# Stripe (Optional - for payments)
# ===========================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
